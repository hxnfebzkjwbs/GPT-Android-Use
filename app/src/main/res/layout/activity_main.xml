<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/deviceText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp" />

        <TextView
            android:id="@+id/oemText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp" />

        <Button
            android:id="@+id/openWirelessDebuggingButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Open wireless debugging" />

        <EditText
            android:id="@+id/pairingPortInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Pairing port shown by Android"
            android:inputType="number" />

        <EditText
            android:id="@+id/pairingCodeInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="6-digit pairing code"
            android:inputType="numberPassword"
            android:maxLength="6" />

        <Button
            android:id="@+id/pairButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pair this phone" />

        <Button
            android:id="@+id/connectButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Auto-connect paired device" />

        <EditText
            android:id="@+id/commandInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:hint="Example: input tap 500 500"
            android:inputType="text" />

        <Button
            android:id="@+id/executeCommandButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Execute ADB shell command" />

        <TextView
            android:id="@+id/commandResultText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textIsSelectable="true" />

    </LinearLayout>
</ScrollView>
