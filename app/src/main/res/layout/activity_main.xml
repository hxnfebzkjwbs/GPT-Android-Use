<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">
        <TextView android:id="@+id/statusText" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="18sp" android:textStyle="bold" />
        <TextView android:id="@+id/deviceText" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="12dp" />
        <TextView android:id="@+id/oemText" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="12dp" />
        <Button android:id="@+id/openDeveloperOptionsButton" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="20dp"
            android:text="Open developer options" />
        <Button android:id="@+id/openWirelessDebuggingButton" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Open wireless debugging" />
        <EditText android:id="@+id/commandInput" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="20dp"
            android:hint="Example: dumpsys window" android:inputType="text" />
        <Button android:id="@+id/validateCommandButton" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Validate command" />
        <TextView android:id="@+id/commandResultText" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="12dp"
            android:textIsSelectable="true" />
    </LinearLayout>
</ScrollView>
